# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Configuration
DEFAULT_MODEL=anthropic/claude-3-haiku
FALLBACK_MODEL=qwen/qwen3-8b
CODE_MODEL=anthropic/claude-sonnet-4

# App Settings
APP_NAME=FaujX JD-CV Matcher
APP_ENV=production
DEBUG=false

# Timeouts
API_TIMEOUT_SECONDS=30

# Database (faujx_dev)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=faujx_dev
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# MCQ Database
MCQ_DATABASE_HOST=localhost
MCQ_DATABASE_PORT=5432
MCQ_DATABASE_NAME=mcq_database
MCQ_DATABASE_USER=your_db_user
MCQ_DATABASE_PASSWORD=your_db_password

# Server
IP=0.0.0.0
Server=ubuntu
